---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HouseLanding from '../components/HouseLanding.astro';
import { avellanedaHouse } from '../data/avellaneda/house';
import { avellanedaReviewRatings, avellanedaReviews } from '../data/avellaneda/reviews';
import { site } from '../data/site';
import { breadcrumbSchema, lodgingSchema } from '../data/site';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const headerWhatsapp = site.whatsappUrl(
  `Hola ${avellanedaHouse.contactName}, quiero consultar disponibilidad para ${avellanedaHouse.name}. Mis fechas tentativas son: `,
  avellanedaHouse.whatsapp
);
---
<BaseLayout title="Casa para grupos cerca de Arístides | Experiencias Mendoza" description={avellanedaHouse.summary} image={avellanedaHouse.heroImage} structuredData={[lodgingSchema(avellanedaHouse), breadcrumbSchema([{name:'Inicio',url:'/'},{name:avellanedaHouse.name,url:'/casa-avellaneda'}])]}>
  <SiteHeader current="avellaneda" whatsappHref={headerWhatsapp} />
  <Breadcrumbs items={[{name:'Inicio',url:'/'},{name:avellanedaHouse.name,url:'/casa-avellaneda'}]} />
  <HouseLanding house={avellanedaHouse} reviews={avellanedaReviews} reviewRatings={avellanedaReviewRatings} internalBase="avellaneda" />
  <SiteFooter />
</BaseLayout>
