---
import GuestGuide from '../components/GuestGuide.astro';
import { avellanedaGuide, parqueGuide } from '../data/guest-guides';

const apiBase = (import.meta.env.PUBLIC_ESTADIA_API_BASE || '/estadia-api').replace(/\/$/, '');
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || '';
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '';
const umamiEnvironment = import.meta.env.PUBLIC_UMAMI_ENVIRONMENT || 'production';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Mi estadía | Experiencias Mendoza</title>
    <style>
      :root { --malbec:#661a30; --malbec-light:#6a2f42; --malbec-dark:#5b0b25; --gold:#b8843d; --gold-pale:#e7c98c; --sage:#53675a; --cream:#f5efe7; --text:#2d2523; }
      * { box-sizing:border-box; }
      html,body { margin:0; min-height:100%; background:radial-gradient(circle at 86% 0,rgba(231,201,140,.16),transparent 26rem),var(--cream); color:var(--text); font-family:'Plus Jakarta Sans',Inter,system-ui,sans-serif; }
      h1,h2,h3,strong { font-family:'Cormorant Garamond',Georgia,serif; }
      [hidden] { display:none !important; }
      .portal-state { min-height:100vh; display:grid; place-items:center; padding:24px; }
      .state-card { width:min(100%,560px); padding:30px; border:1px solid rgba(33,29,26,.12); border-radius:24px; background:#fffdf9; box-shadow:0 18px 44px rgba(30,22,16,.08); text-align:center; }
      .state-card h1 { margin:0 0 10px; font-size:clamp(30px,8vw,48px); letter-spacing:-.04em; }
      .state-card p { margin:0; color:#6f675f; line-height:1.6; }
      .stay-companion { position:fixed; right:22px; bottom:22px; z-index:90; width:min(360px,calc(100vw - 32px)); overflow:hidden; border:1px solid rgba(255,255,255,.22); border-radius:22px; background:linear-gradient(145deg,var(--malbec-light),var(--malbec-dark)); color:white; box-shadow:0 20px 54px rgba(71,27,36,.3),inset 0 1px 0 rgba(255,255,255,.24); animation:companion-in .9s cubic-bezier(.22,.7,.25,1) both; }
      .companion-toggle { width:100%; display:grid; grid-template-columns:1fr auto; gap:6px 16px; padding:18px 20px; border:0; background:transparent; color:inherit; text-align:left; cursor:pointer; }
      .companion-copy { min-width:0; }
      .companion-label { display:block; margin-bottom:4px; opacity:.78; font-size:11px; font-weight:850; letter-spacing:.1em; text-transform:uppercase; }
      .companion-name { display:block; overflow:hidden; font-size:21px; line-height:1.15; text-overflow:ellipsis; white-space:nowrap; }
      .companion-state { grid-column:1 / -1; margin:4px 0 0; font-size:14px; font-weight:700; line-height:1.4; }
      .companion-chevron { width:31px; height:31px; display:grid; place-items:center; border:1px solid rgba(231,201,140,.45); border-radius:50%; background:rgba(231,201,140,.14); color:var(--gold-pale); font-size:18px; transition:transform .2s ease; }
      .stay-companion[data-expanded="true"] .companion-chevron { transform:rotate(180deg); }
      .companion-details { display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:0 18px 18px; }
      .stay-companion[data-expanded="false"] .companion-details { display:none; }
      .companion-date { padding:12px; border:1px solid rgba(255,255,255,.18); border-radius:14px; background:rgba(255,255,255,.09); }
      .companion-date span { display:block; margin-bottom:4px; opacity:.72; font-size:10px; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
      .companion-date b { display:block; font-size:13px; line-height:1.35; }
      @keyframes companion-in { from { opacity:0; transform:translateY(24px) scale(.96); } }
      .loading-brand { padding:18px 16px; border-bottom:1px solid rgba(33,29,26,.1); background:#fffdf9; }
      .loading-brand-inner { width:min(100%,1120px); margin:auto; display:flex; justify-content:space-between; align-items:center; gap:18px; }
      .loading-brand strong { font-size:17px; }
      .loading-brand span { color:#756d65; font-size:13px; font-weight:700; }
      @media(max-width:700px){
        .loading-brand span{display:none}
        .stay-companion { right:12px; bottom:max(12px,env(safe-area-inset-bottom)); width:calc(100vw - 24px); border-radius:18px; }
        .companion-toggle { padding:14px 16px; }
        .companion-name { font-size:17px; }
        .companion-state { font-size:12px; }
        .companion-details { padding:0 14px 14px; }
      }
    </style>
  </head>
  <body data-api-base={apiBase}>
    <div data-loading aria-live="polite" aria-busy="true">
      <div class="loading-brand">
        <div class="loading-brand-inner"><strong>Experiencias Mendoza</strong><span>Mi estadía</span></div>
      </div>
      <div data-loading-guide-wrapper="parque" hidden><GuestGuide guide={parqueGuide} embedded /></div>
      <div data-loading-guide-wrapper="avellaneda" hidden><GuestGuide guide={avellanedaGuide} embedded /></div>
    </div>

    <section class="portal-state" data-error hidden>
      <div class="state-card"><h1>Este enlace no está disponible</h1><p>Puede haber vencido o haber sido reemplazado. Pedile al anfitrión un nuevo enlace.</p></div>
    </section>

    <div data-portal hidden>
      <aside class="stay-companion" data-stay-companion data-expanded="false" aria-label="Información de tu estadía">
        <button class="companion-toggle" type="button" data-companion-toggle aria-expanded="false">
          <span class="companion-copy"><span class="companion-label" data-phase-label>Tu estadía</span><strong class="companion-name" data-greeting></strong></span>
          <span class="companion-chevron" aria-hidden="true">⌄</span>
          <span class="companion-state" data-phase-message></span>
        </button>
        <div class="companion-details">
          <div class="companion-date"><span>Check-in</span><b data-check-in></b></div>
          <div class="companion-date"><span>Check-out</span><b data-check-out></b></div>
        </div>
      </aside>
      <div data-guide-wrapper="parque" hidden><GuestGuide guide={parqueGuide} embedded /></div>
      <div data-guide-wrapper="avellaneda" hidden><GuestGuide guide={avellanedaGuide} embedded /></div>
    </div>

    <script define:vars={{ apiBase, umamiScriptUrl, umamiWebsiteId, umamiEnvironment }}>
      const loading = document.querySelector('[data-loading]');
      const error = document.querySelector('[data-error]');
      const portal = document.querySelector('[data-portal]');
      const companion = document.querySelector('[data-stay-companion]');
      const companionToggle = document.querySelector('[data-companion-toggle]');
      companionToggle?.addEventListener('click', () => {
        const expanded = companion.dataset.expanded !== 'true';
        companion.dataset.expanded = String(expanded);
        companionToggle.setAttribute('aria-expanded', String(expanded));
      });
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const searchParams = new URLSearchParams(window.location.search);
      const token = searchParams.get('token') || (pathParts[0] === 'estadia' ? pathParts[1] : '');
      let houseHint = searchParams.get('casa') || '';
      try { houseHint ||= localStorage.getItem(`estadia-house:${token}`) || ''; } catch {}
      if (['parque','avellaneda'].includes(houseHint)) {
        document.querySelector(`[data-loading-guide-wrapper="${houseHint}"]`).hidden = false;
      }

      const localIsoDate = (timeZone) => {
        const parts = new Intl.DateTimeFormat('en-CA', { timeZone, year:'numeric', month:'2-digit', day:'2-digit' }).formatToParts(new Date());
        const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
        return `${values.year}-${values.month}-${values.day}`;
      };
      const dayNumber = (iso) => Date.parse(`${iso}T00:00:00Z`) / 86400000;
      const displayDate = (iso) => new Intl.DateTimeFormat('es-AR', { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' }).format(new Date(`${iso}T12:00:00Z`));
      const syncServiceLinks = (stay) => {
        const wrapper = document.querySelector(`[data-guide-wrapper="${stay.casa}"]`);
        wrapper?.querySelectorAll('[data-service-link]').forEach((link) => {
          const serviceTitle = link.closest('.service-offer')?.querySelector('h3')?.textContent?.trim() || 'un servicio';
          const houseName = link.dataset.houseName || stay.casa;
          const message = [
            `Hola Bruno, soy ${stay.nombre}. Quiero consultar por el servicio de ${serviceTitle}.`,
            '',
            `Casa: ${houseName}`,
            `Check-in: ${displayDate(stay.check_in)}`,
            `Check-out: ${displayDate(stay.check_out)}`,
            '',
            'Detalle:',
            '-'
          ].join('\\n');
          const url = new URL(link.href);
          url.searchParams.set('text', message);
          link.href = url.href;
        });
      };
      const phaseCopy = (today, checkIn, checkOut) => {
        const current = dayNumber(today), arrival = dayNumber(checkIn), departure = dayNumber(checkOut);
        if (current < arrival) {
          const days = arrival - current;
          return ['Antes de tu llegada', days === 1 ? 'Falta 1 día para recibirte.' : `Faltan ${days} días para recibirte.`];
        }
        if (current === arrival) return ['Día de llegada', 'Hoy te esperamos. Tené a mano la dirección y las indicaciones de acceso.'];
        if (current === departure - 1) return ['Antes de la salida', 'Mañana es tu check-out. Revisá el checklist y las indicaciones de llaves y residuos.'];
        if (current === departure) return ['Día de salida', 'Hoy es tu check-out. La salida es hasta las 10:00.'];
        if (current > departure) return ['Estadía finalizada', 'Gracias por habernos elegido. Esperamos que hayas disfrutado Mendoza.'];
        return ['Durante tu estadía', 'Encontrá aquí el Wi-Fi y toda la información para disfrutar la casa.'];
      };

      const analyticsSections = { esencial:'essentials', llegada:'arrival', casa:'house', residuos:'waste', normas:'rules', salida:'checkout', mendoza:'recommendations', ayuda:'help' };
      const analyticsState = { context:null, ready:false, startedAt:Date.now(), lastInteraction:Date.now(), activeSent:false };
      const analyticsTrack = (eventName, data = {}) => {
        try { if (analyticsState.ready && window.umami) window.umami.track(eventName, { ...analyticsState.context, ...data }); } catch {}
      };
      const durationBucket = (milliseconds) => {
        const minutes = milliseconds / 60000;
        if (minutes < 1) return 'under_1m';
        if (minutes < 3) return '1_to_3m';
        if (minutes < 10) return '3_to_10m';
        return 'over_10m';
      };
      const setupAnalytics = (stay, stayPhase) => {
        if (!umamiScriptUrl || !umamiWebsiteId) return;
        const validChannels = ['airbnb','booking','direct','other','unknown'];
        const channel = validChannels.includes(stay.channel) ? stay.channel : 'unknown';
        analyticsState.context = { house: stay.casa, channel, stay_phase: stayPhase, environment: umamiEnvironment, ...(stay.stay_ref ? { stay_ref: stay.stay_ref } : {}) };
        const start = () => {
          analyticsState.ready = true;
          try { window.umami.track({ url:'/estadia', title:'Mi estadia' }); } catch {}
          analyticsTrack('portal_opened');
          const markInteraction = () => { analyticsState.lastInteraction = Date.now(); };
          ['click','keydown','touchstart','scroll'].forEach((eventName) => window.addEventListener(eventName, markInteraction, { passive:true }));
          const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
            if (!entry.isIntersecting || entry.intersectionRatio < .5 || entry.target.dataset.analyticsSeen) {
              if (entry.target.dataset.analyticsTimer) window.clearTimeout(Number(entry.target.dataset.analyticsTimer));
              delete entry.target.dataset.analyticsTimer;
              return;
            }
            entry.target.dataset.analyticsTimer = String(window.setTimeout(() => {
              entry.target.dataset.analyticsSeen = 'true';
              analyticsTrack('section_viewed', { section: analyticsSections[entry.target.id] || 'house' });
            }, 2000));
          }), { threshold:[.5] });
          Object.keys(analyticsSections).forEach((id) => { const node = document.getElementById(id); if (node) observer.observe(node); });
          document.querySelectorAll('[data-reveal]').forEach((button) => button.addEventListener('click', () => {
            const target = button.getAttribute('data-reveal') || '';
            const action = target.includes('wifi') ? 'wifi' : target.includes('address') ? 'address' : '';
            if (action) analyticsTrack('private_info_revealed', { action });
          }));
          document.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
            const href = link.getAttribute('href') || '';
            const action = href.includes('google.') || href.includes('maps') ? 'maps' : href.startsWith('tel:') ? 'emergency_call' : href.includes('wa.me') ? (link.closest('.help-card') ? 'backup_whatsapp' : 'host_whatsapp') : '';
            if (action) analyticsTrack('external_action_opened', { action });
          }));
          companionToggle?.addEventListener('click', () => analyticsTrack('stay_companion_changed', { state: companion?.dataset.expanded === 'true' ? 'expanded' : 'collapsed' }));
          const sendActiveTime = () => {
            if (analyticsState.activeSent || document.visibilityState !== 'hidden' || Date.now() - analyticsState.lastInteraction > 300000) return;
            analyticsState.activeSent = true;
            analyticsTrack('active_time_recorded', { duration_bucket: durationBucket(Date.now() - analyticsState.startedAt) });
          };
          document.addEventListener('visibilitychange', sendActiveTime);
          window.addEventListener('pagehide', sendActiveTime);
        };
        const script = document.createElement('script');
        script.defer = true;
        script.src = umamiScriptUrl;
        script.dataset.websiteId = umamiWebsiteId;
        script.dataset.autoPageview = 'false';
        script.dataset.excludeSearch = 'true';
        script.addEventListener('load', start, { once:true });
        document.head.append(script);
      };

      const showError = () => { loading.hidden = true; portal.hidden = true; error.hidden = false; };

      if (!token || !/^[A-Za-z0-9_-]{32,160}$/.test(token)) {
        showError();
      } else {
        const isLocalAudit = ['localhost', '127.0.0.1'].includes(location.hostname) || /^(10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.)/.test(location.hostname);
        const coldStartQuery = isLocalAudit ? '?simulate_cold_start=8' : '';
        fetch(`${apiBase}/estadia/${encodeURIComponent(token)}${coldStartQuery}`, { headers:{ Accept:'application/json' }, credentials:'omit', cache:'no-store' })
          .then((response) => { if (!response.ok) throw new Error('unavailable'); return response.json(); })
          .then((stay) => {
            if (!['parque','avellaneda'].includes(stay.casa)) throw new Error('unavailable');
            try { localStorage.setItem(`estadia-house:${token}`, stay.casa); } catch {}
            if (!searchParams.has('casa')) {
              const currentUrl = new URL(window.location.href);
              currentUrl.searchParams.set('casa', stay.casa);
              history.replaceState(null, '', currentUrl);
            }
            const [label, message] = phaseCopy(localIsoDate(stay.timezone), stay.check_in, stay.check_out);
            document.querySelector('[data-phase-label]').textContent = label;
            document.querySelector('[data-phase-message]').textContent = message;
            document.querySelector('[data-greeting]').textContent = `Hola, ${stay.nombre}`;
            document.querySelector('[data-check-in]').textContent = displayDate(stay.check_in);
            document.querySelector('[data-check-out]').textContent = displayDate(stay.check_out);
            syncServiceLinks(stay);
            const expanded = window.matchMedia('(min-width:701px)').matches;
            companion.dataset.expanded = String(expanded);
            companionToggle.setAttribute('aria-expanded', String(expanded));
            document.querySelectorAll('[data-guide-wrapper]').forEach((guide) => {
              if (guide.dataset.guideWrapper === stay.casa) guide.hidden = false;
              else guide.remove();
            });
            loading.hidden = true;
            portal.hidden = false;
            const currentDay = dayNumber(localIsoDate(stay.timezone));
            const stayPhase = currentDay < dayNumber(stay.check_in) ? 'before' : currentDay === dayNumber(stay.check_in) ? 'arrival' : currentDay === dayNumber(stay.check_out) ? 'departure' : currentDay > dayNumber(stay.check_out) ? 'after' : 'during';
            setupAnalytics(stay, stayPhase);
          })
          .catch(showError);
      }
    </script>
  </body>
</html>
