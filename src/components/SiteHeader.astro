---
import BrandLogo from './BrandLogo.astro';
import { site } from '../data/site';

const {
  current = '',
  whatsappHref = site.whatsappUrl('Hola Bruno, quiero consultar por una estadia en Experiencias Mendoza')
} = Astro.props;
---

<header class:list={['topbar', { 'house-header': Astro.props.central || current === 'parque' || current === 'avellaneda' }]}>
  <div class="container topbar-inner">
    <div class="header-brand" data-brand-navigation>
      <a href="/" class="brand" aria-label="Experiencias Mendoza, inicio"><BrandLogo animated showTagline={false} motionControls={false}/></a>
      <button type="button" class="brand-toggle" data-brand-toggle aria-label="Pausar animación del logo" aria-pressed="false" title="Pausar animación del logo"><svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path class="pause-icon" d="M6 4v12M14 4v12" fill="none" stroke="currentColor" stroke-width="2"/><path class="play-icon" d="m6 3 10 7-10 7z" fill="currentColor"/></svg></button>
    </div>

    <div class="nav-wrap">
      <nav class="main-nav" aria-label="Navegación principal">
        <a href="/" aria-current={current === 'home' ? 'page' : undefined}>Home</a>
        <a href="/la-casa-frente-al-parque" aria-current={current === 'parque' ? 'page' : undefined}>La Casa Frente al Parque</a>
        <a href="/casa-avellaneda" aria-current={current === 'avellaneda' ? 'page' : undefined}>Casa Avellaneda</a>
        <a href="/servicios" aria-current={current === 'servicios' ? 'page' : undefined}>Servicios</a>
      </nav>

      <a class="btn btn-primary whatsapp-top" href={whatsappHref} target="_blank" rel="noreferrer" data-analytics-event="consultation_click" aria-label="Consultar por WhatsApp">
        WhatsApp
      </a>
    </div>
  </div>
</header>

<style>
  .header-brand{display:flex;align-items:center;gap:4px;min-width:0}
  .brand-toggle{display:grid;place-items:center;width:28px;height:32px;padding:0;flex:none;border:0;border-radius:5px;color:var(--brand-forest);background:transparent;cursor:pointer}
  .brand-toggle:hover{background:#173d340c}.brand-toggle:focus-visible{outline:2px solid currentColor;outline-offset:2px}.brand-toggle .play-icon{display:none}.brand-toggle[data-play='true'] .pause-icon{display:none}.brand-toggle[data-play='true'] .play-icon{display:block}
  .nav-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .whatsapp-top {
    min-height: 42px;
    padding: 0 16px;
    white-space: nowrap;
  }

  .main-nav a[aria-current='page'] {
    color: var(--malbec-dark);
    font-weight: 700;
  }

  .main-nav { gap: 16px; }

  .main-nav a { white-space: nowrap; transition: color .2s ease; }
  .main-nav a:hover { color: var(--malbec); }

  @media (max-width: 900px) {
    .topbar .topbar-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 12px;
      padding: 10px 0 4px;
      min-height: 64px;
    }
    .topbar .brand { min-width: 0; }
    .topbar .brand :global(.em-brand){width:148px;max-width:100%}
    .topbar .brand strong { font-size: 21px; line-height: 1.05; overflow-wrap: anywhere; }
    .topbar .brand > span:not(.em-brand) { display: none; }
    .topbar .nav-wrap { display: contents; }
    .topbar .whatsapp-top { grid-column: 2; grid-row: 1; width: auto; min-height: 44px; padding: 0 14px; font-size: 13px; }
    .topbar .main-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 18px;
      min-width: 0;
    }
    .topbar .main-nav a { flex-shrink: 0; display: inline-flex; align-items: center; min-height: 40px; font-size: 12px; }
  }
</style>
