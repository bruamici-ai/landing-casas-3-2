---
import { site } from '../data/site';

const {
  current = '',
  whatsappHref = site.whatsappUrl('Hola Bruno, quiero consultar por una estadia en Experiencias Mendoza')
} = Astro.props;
---

<header class:list={['topbar', { 'house-header': Astro.props.central || current === 'parque' || current === 'avellaneda' }]}>
  <div class="container topbar-inner">
    <a href="/" class="brand">
      <strong>{site.brand}</strong>
      <span>Casas para vivir Mendoza con otro ritmo</span>
    </a>

    <div class="nav-wrap">
      <nav class="main-nav" aria-label="Navegación principal">
        <a href="/" aria-current={current === 'home' ? 'page' : undefined}>Home</a>
        <a href="/la-casa-frente-al-parque" aria-current={current === 'parque' ? 'page' : undefined}>La Casa Frente al Parque</a>
        <a href="/casa-avellaneda" aria-current={current === 'avellaneda' ? 'page' : undefined}>Casa Avellaneda</a>
        <a href="/servicios" aria-current={current === 'servicios' ? 'page' : undefined}>Servicios</a>
      </nav>

      <a class="btn btn-primary whatsapp-top" href={whatsappHref} target="_blank" rel="noreferrer" data-analytics-event="consultation_click" aria-label="Consultar por WhatsApp">
        WhatsApp
      </a>
    </div>
  </div>
</header>

<style>
  .nav-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .whatsapp-top {
    min-height: 42px;
    padding: 0 16px;
    white-space: nowrap;
  }

  .main-nav a[aria-current='page'] {
    color: var(--malbec-dark);
    font-weight: 700;
  }

  .main-nav { gap: 16px; }

  .main-nav a { white-space: nowrap; transition: color .2s ease; }
  .main-nav a:hover { color: var(--malbec); }

  @media (max-width: 900px) {
    .nav-wrap {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
    }

    .whatsapp-top {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 840px) {
    .house-header .topbar-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 12px;
      padding: 10px 0 4px;
      min-height: 64px;
    }
    .house-header .brand { min-width: 0; }
    .house-header .brand strong { font-size: 21px; line-height: 1.05; overflow-wrap: anywhere; }
    .house-header .brand span { display: none; }
    .house-header .nav-wrap { display: contents; }
    .house-header .whatsapp-top { grid-column: 2; grid-row: 1; width: auto; min-height: 44px; padding: 0 14px; font-size: 13px; }
    .house-header .main-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 18px;
      min-width: 0;
    }
    .house-header .main-nav a { flex-shrink: 0; display: inline-flex; align-items: center; min-height: 40px; font-size: 12px; }
  }
</style>
