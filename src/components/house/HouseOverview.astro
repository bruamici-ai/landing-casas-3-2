---
import UiIcon from '../UiIcon.astro';
const { house } = Astro.props;

const capacity = house.capacity ?? house.capacidad ?? '14';
const bedrooms = house.bedrooms ?? house.habitaciones ?? 'varios';
const bathrooms = house.bathrooms ?? house.banos ?? house.baños ?? 'varios';
const title = house.experienceTitle ?? 'Una casa pensada para vivir Mendoza con comodidad.';
const summary = house.experienceSummary ?? house.summary;
---

<section class="section overview" id="experiencia">
  <div class="shell overview-card">
    <div class="overview-copy">
      <span class="section-label">La experiencia</span>
      <h2>{title}</h2>
      <p>
        {summary}
      </p>
    </div>

    <div class="overview-grid">
      <article>
        <i><UiIcon name="guests" size={34} /></i>
        <div><strong>{capacity}</strong><span>hu&eacute;spedes</span></div>
      </article>

      <article>
        <i><UiIcon name="bed" size={34} /></i>
        <div><strong>{bedrooms}</strong><span>dormitorios</span></div>
      </article>

      <article>
        <i><UiIcon name="bath" size={34} /></i>
        <div><strong>{bathrooms}</strong><span>ba&ntilde;os</span></div>
      </article>

      <article>
        <i><UiIcon name="pin" size={34} /></i>
        <div><strong>{house.location ?? 'Mendoza'}</strong><span>zona</span></div>
      </article>
    </div>
  </div>
</section>

<style>
.overview {
  padding: 56px 0;
}

.overview-card {
  background: rgba(255,255,255,.74);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 34px;
  box-shadow: var(--shadow);
  display: grid;
  grid-template-columns: minmax(260px, .82fr) minmax(0, 1.18fr);
  gap: 42px;
  align-items: center;
}

.section-label {
  display: block;
  margin-bottom: 12px;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: .12em;
  color: var(--olive);
  font-weight: 700;
}

.overview-card h2 {
  font-size: clamp(32px, 4vw, 52px);
  line-height: .95;
  margin: 0 0 16px;
}

.overview-card p {
  max-width: 520px;
  margin-bottom: 0;
  color: var(--muted);
  line-height: 1.6;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.overview-grid article {
  background: #f6f0ea;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 22px;
  min-height: 112px;
  display: grid;
  grid-template-columns: 60px minmax(0, 1fr);
  gap: 16px;
  align-items: center;
  justify-content: center;
}

.overview-grid i {
  width: 60px;
  height: 60px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: rgba(109,117,82,.12);
  color: var(--olive-dark);
  font-style: normal;
}

.overview-grid strong {
  display: block;
  font-size: 26px;
  line-height: 1.08;
  overflow-wrap: anywhere;
}

.overview-grid article:last-child strong { font-size: clamp(18px, 1.8vw, 23px); }

.overview-grid span {
  color: var(--muted);
  font-size: 14px;
}

@media (max-width: 850px) {
  .overview-card {
    grid-template-columns: 1fr;
    padding: 28px;
  }
}
</style>
