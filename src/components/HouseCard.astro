---
import UiIcon from './UiIcon.astro';
const { house } = Astro.props;

const featureIcon = (feature: string) => {
  const text = feature.toLowerCase();
  if (/hu[eé]sped|capacidad/.test(text)) return 'guests';
  if (/habitaci[oó]n|dormitorio|cama/.test(text)) return 'bed';
  if (/baño|baños|jacuzzi|piscina/.test(text)) return 'bath';
  if (/cochera|veh[ií]culo|estacionamiento|port[oó]n/.test(text)) return 'car';
  if (/wifi|internet|radio|sonido|tv|theater/.test(text)) return 'wifi';
  if (/patio|parque|exterior|fogonero|churrasquera/.test(text)) return 'outdoor';
  if (/aire|calefacci[oó]n|estufa/.test(text)) return 'climate';
  if (/ubicaci[oó]n|quinta secci[oó]n/.test(text)) return 'pin';
  return 'check';
};
---

<a class="house-card" href={`/${house.slug}`} data-analytics-event="property_view">
  <div class="card-image">
    <img src={house.heroImage} alt={`Vista principal de ${house.name} en Mendoza`} width="1200" height="800" loading="lazy" />
    <span class="card-badge">{house.badge}</span>
  </div>
  <div class="card-body">
    <div class="card-location">{house.location}</div>
    <h3 class="card-name">{house.name}</h3>
    <p class="card-summary">{house.summary}</p>
    <ul class="card-features">
      {house.features.slice(0, 12).map((f: string) => <li><i><UiIcon name={featureIcon(f)} size={16} /></i><span>{f}</span></li>)}
    </ul>
    <span class="card-arrow">Ver casa →</span>
  </div>
</a>

<style>
.house-card {
  display: flex;
  flex-direction: column;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid var(--line, rgba(36,28,22,.11));
  background: #fff;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 14px 42px rgba(48,35,28,.08);
  transition: transform .25s ease, box-shadow .25s ease;
}

.house-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 24px 60px rgba(48,35,28,.14);
}

.card-image {
  position: relative;
  height: 260px;
  overflow: hidden;
}

.card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .4s ease;
}

.house-card:hover .card-image img {
  transform: scale(1.04);
}

.card-badge {
  position: absolute;
  bottom: 14px;
  left: 14px;
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(255,255,255,.92);
  font-size: .76rem;
  font-weight: 800;
  color: #211915;
  box-shadow: 0 4px 14px rgba(0,0,0,.12);
}

.card-body {
  padding: 22px 24px 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.card-location {
  font-size: .75rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--wine, #7a2e49);
}

.card-name {
  margin: 0;
  font-size: clamp(1.3rem, 2.5vw, 1.7rem);
  line-height: 1.1;
  letter-spacing: -.04em;
  color: #211915;
}

.card-summary {
  margin: 0;
  font-size: .9rem;
  line-height: 1.65;
  color: #71665e;
}

.card-features {
  list-style: none;
  margin: 4px 0 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.card-features li {
  min-width: 0;
  min-height: 38px;
  padding: 7px 10px;
  background: #f6f0ea;
  border: 1px solid rgba(109,117,82,.1);
  border-radius: 12px;
  font-size: .78rem;
  font-weight: 700;
  color: #211915;
  display: grid;
  grid-template-columns: 24px minmax(0, 1fr);
  gap: 7px;
  align-items: center;
  line-height: 1.25;
}

.card-features i {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: rgba(109,117,82,.12);
  color: var(--olive-dark, #576041);
  font-style: normal;
}

@media (max-width: 480px) {
  .card-features { grid-template-columns: 1fr; }
}

.card-arrow {
  display: inline-block;
  margin-top: 6px;
  font-size: .84rem;
  font-weight: 800;
  color: var(--wine, #7a2e49);
}
</style>
