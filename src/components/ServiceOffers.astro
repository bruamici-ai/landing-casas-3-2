---
import { services } from '../data/site';
import { site } from '../data/site';

const { context = 'house', limit = context === 'stay' ? 20 : 8, houseName = '' } = Astro.props;
const visibleServices = services.filter((service) => service.status !== 'draft').slice(0, limit);
---

<section class:list={['service-offers', `service-offers--${context}`]} id="servicios">
  <div class="service-offers__inner">
    <div class="service-offers__head">
      <div>
        <span class="service-offers__label">Servicios para sumar</span>
        <h2>Todo lo que podemos dejar resuelto antes o durante la estadía.</h2>
      </div>
      <p>Elegí lo que te serviría y lo coordinamos según la casa, las fechas y el grupo.</p>
    </div>

    <div class="service-offers__grid">
      {visibleServices.map((service) => {
        const upcoming = service.status === 'upcoming';
        return (
          <article class:list={['service-offer', { upcoming }]}>
            <div class="service-offer__topline"><span>{service.statusLabel}</span></div>
            <h3>{service.title}</h3>
            <p>{service.short}</p>
            {upcoming ? (
              <span class="service-offer__link">Estamos preparándolo</span>
            ) : (
              <a
                class="service-offer__link"
                href={site.whatsappUrl(`Hola Bruno, quiero consultar por el servicio de ${service.title}${houseName ? ` para ${houseName}` : ''}. `)}
                target="_blank"
                rel="noreferrer"
                data-service-link={service.slug}
                data-house-name={houseName}
              >
                Consultar <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        );
      })}
    </div>

    {context === 'house' && <a class="service-offers__all" href="/servicios">Ver todos los servicios</a>}
  </div>
</section>

<style>
  .service-offers { padding: 56px 0; }
  .service-offers__inner { width:min(1180px,calc(100% - 28px)); margin:0 auto; padding:34px; border:1px solid var(--line,rgba(45,37,35,.12)); border-radius:28px; background:rgba(255,255,255,.72); box-shadow:var(--shadow,0 18px 44px rgba(71,27,36,.10)); }
  .service-offers__head { display:grid; grid-template-columns:minmax(0,1fr) minmax(240px,.72fr); gap:28px; align-items:end; margin-bottom:24px; }
  .service-offers__label { display:block; margin-bottom:12px; color:var(--gold); font-size:12px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .service-offers h2 { max-width:720px; margin:0; font-size:clamp(30px,4vw,48px); line-height:.98; letter-spacing:-.04em; }
  .service-offers__head p,.service-offer p { margin:0; color:var(--muted); line-height:1.65; }
  .service-offers__grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
  .service-offer { min-height:190px; display:flex; flex-direction:column; padding:18px; border:1px solid var(--line,rgba(45,37,35,.12)); border-radius:18px; background:rgba(255,255,255,.76); }
  .service-offer.upcoming { background:#f4f0ea; }
  .service-offer__topline { margin-bottom:20px; color:var(--olive); font-size:10px; font-weight:850; letter-spacing:.07em; line-height:1.25; text-transform:uppercase; }
  .service-offer.upcoming .service-offer__topline { color:var(--muted); }
  .service-offer h3 { margin:0 0 7px; font-size:25px; line-height:1; }
  .service-offer__link { margin-top:auto; padding-top:18px; color:var(--olive); font-size:13px; font-weight:850; text-decoration:none; }
  .service-offer__link span { margin-left:5px; }
  .service-offers__all { display:inline-block; margin-top:22px; color:var(--olive); font-size:14px; font-weight:800; text-decoration:underline; text-underline-offset:4px; }
  @media (max-width:980px) { .service-offers__grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:650px) { .service-offers { padding:38px 0; } .service-offers__inner { padding:22px; border-radius:22px; } .service-offers__head { grid-template-columns:1fr; gap:12px; } .service-offers__grid { grid-template-columns:1fr; } .service-offer { min-height:0; } }
</style>
