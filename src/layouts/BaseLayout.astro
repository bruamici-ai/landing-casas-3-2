---
import { site } from '../data/site';

const {
  title = 'Experiencias Mendoza',
  description = 'Casas y servicios en Mendoza',
  image = site.defaultImage,
  url = Astro.url.href,
  noindex = false,
  structuredData = []
} = Astro.props;

const canonicalUrl = new URL(url, Astro.site ?? site.url).href;
const previewImage = image ? new URL(image, Astro.site ?? site.url).href : '';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {previewImage && <meta property="og:image" content={previewImage} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.brand} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {previewImage && <meta name="twitter:image" content={previewImage} />}
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    {structuredData.map((data: object) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_MEASUREMENT_ID}`}></script>
    )}
    {import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
      <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments)}
        gtag('js', new Date());
        gtag('config', gaId, { anonymize_ip: true });
        document.addEventListener('click', (event) => {
          const link = event.target.closest('a');
          if (!link) return;
          const eventName = link.dataset.analyticsEvent || (link.href.includes('wa.me') ? 'whatsapp_click' : '');
          if (eventName) gtag('event', eventName, { link_url: link.href, link_text: link.textContent.trim() });
        });
      </script>
    )}
    <style is:global>
      :root {
        /* Malbec base HSL(344, 59%, 25%); clara HSL(344, 39%, 30%); oscura HSL(344, 79%, 20%). */
        --bg: #f5efe7;
        --surface: #fffdfc;
        --text: #2d2523;
        --muted: #756762;
        --line: rgba(45,37,35,.12);
        --malbec: #661a30;
        --malbec-light: #6a2f42;
        --malbec-dark: #5b0b25;
        --gold: #b8843d;
        --gold-pale: #e7c98c;
        --sage: #53675a;
        --olive: #661a30;
        --olive-dark: #5b0b25;
        --sand: #e7d8c8;
        --radius-xl: 30px;
        --radius-lg: 22px;
        --shadow: 0 18px 44px rgba(71,27,36,.10), 0 3px 10px rgba(71,27,36,.05);
        --shadow-hover: 0 24px 60px rgba(71,27,36,.16), 0 6px 14px rgba(71,27,36,.08);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: 'Plus Jakarta Sans', Inter, system-ui, sans-serif;
        background: radial-gradient(circle at 84% 4%, rgba(231,201,140,.16), transparent 24rem), linear-gradient(180deg, #fbf9f5 0%, var(--bg) 100%);
        color: var(--text);
      }
      h1, h2, h3, h4 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 600; }
      a { color: inherit; }
      img { max-width: 100%; display: block; }
      .container { width: min(1180px, calc(100% - 28px)); margin: 0 auto; }
      .eyebrow {
        display: inline-block;
        margin: 0 0 12px;
        color: var(--olive);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-size: 12px;
      }
      .section-head {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        align-items: end;
        margin-bottom: 24px;
      }
      .section-head h2 {
        margin: 0;
        font-size: clamp(28px, 4vw, 44px);
        line-height: 1.02;
        letter-spacing: -0.04em;
      }
      .section-head p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }
      .topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        backdrop-filter: blur(12px);
        background: rgba(250,245,239,.84);
        border-bottom: 1px solid var(--line);
      }
      .topbar-inner {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }
      .brand { text-decoration: none; }
      .brand strong { display: block; color: var(--malbec-dark); font-family: 'Cormorant Garamond', Georgia, serif; font-size: 25px; line-height: .9; letter-spacing: -.02em; }
      .brand span { display: block; font-size: 13px; color: var(--muted); }
      .main-nav { display: flex; gap: 14px; flex-wrap: wrap; }
      .main-nav a {
        text-decoration: none;
        color: var(--muted);
        font-size: 14px;
      }
      .btn {
        position: relative;
        overflow: hidden;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 18px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
      }
      .btn::before { content: ''; position: absolute; inset: 1px 12% auto; height: 1px; background: rgba(255,255,255,.42); opacity: .7; }
      .btn-primary { background: linear-gradient(135deg, var(--malbec-light), var(--malbec-dark)); color: white; box-shadow: 0 8px 18px rgba(91,11,37,.18), inset 0 1px 0 rgba(255,255,255,.22); transition: transform .2s ease, box-shadow .2s ease; }
      .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 13px 26px rgba(91,11,37,.25), inset 0 1px 0 rgba(255,255,255,.25); }
      .btn-secondary { background: rgba(255,255,255,.8); border: 1px solid var(--line); }
      .hero-basic { padding: 72px 0 34px; }
      .hero-basic h1 { margin: 0; font-size: clamp(40px, 7vw, 72px); line-height: .98; letter-spacing: -.05em; }
      .hero-basic p { max-width: 70ch; color: var(--muted); line-height: 1.75; font-size: 17px; }
      .card {
        background: rgba(255,255,255,.74);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow);
      }
      footer.site-footer { padding: 24px 0 48px; color: var(--muted); font-size: 14px; }
      @media (max-width: 840px) {
        .topbar-inner, .section-head { grid-template-columns: 1fr; display: grid; }
        .main-nav { gap: 10px; }
        .hero-basic { padding-top: 52px; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
